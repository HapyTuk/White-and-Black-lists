--=== 22. ТЕЛЕПОРТЫ ===
local function tpTo(pos)
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    for i = 1, 3 do
        r.CFrame = CFrame.new(pos)
        task.wait(0.15)
        if (r.Position - pos).Magnitude < 10 then return true end
    end
    return false
end

local function tpToDrill()
    local drill = Workspace:FindFirstChild("Drill")
    if not drill then return false end
    local part = drill:FindFirstChild("DrillPhysicsSeat")
        or drill:FindFirstChild("VehicleSeat")
        or drill.PrimaryPart
        or drill:FindFirstChild("HumanoidRootPart")
    if not part then return false end
    local pos = part.Position - part.CFrame.LookVector * 10 + Vector3.new(0, 5, 0)
    return tpTo(pos)
end

local function tpToMarket()
    return tpTo(Vector3.new(13965, 3, -847))
end

--=== 23. GODMODE SPOOF ===
local spoofConn, spoofStep
local oldCF = CFrame.new()

local function applySpoof(on)
    if spoofConn then spoofConn:Disconnect(); spoofConn = nil end
    if spoofStep then
        pcall(function() RunService:UnbindFromRenderStep(spoofStep) end)
        spoofStep = nil
    end
    if not on then return end

    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end

    oldCF = r.CFrame
    spoofStep = "3artAimSpoof_" .. tostring(math.random(1, 1e6))

    RunService:BindToRenderStep(spoofStep, Enum.RenderPriority.Camera.Value - 1, function()
        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        if rt then rt.CFrame = oldCF end
    end)
    table.insert(RenderSteps, spoofStep)

    spoofConn = RunService.PostSimulation:Connect(function()
        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        if rt then
            oldCF = rt.CFrame
            rt.CFrame = CFrame.new(rt.Position - Vector3.yAxis * Cfg.GodModeStuds)
                * CFrame.Angles(math.rad(90), 0, 0)
        end
    end)
end

