--=== 15. АНТИ-ЗАСТРЕВАНИЕ В ПОЕЗДЕ ===
local trainConn
local function applyAntiTrain(on)
    if trainConn then trainConn:Disconnect(); trainConn = nil end
    if not on then return end
    trainConn = RunService.Heartbeat:Connect(function()
        local c = LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then return end

        if h.Sit then
            pcall(function()
                h.Sit = false
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end

        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("train") or n:find("tren")
                    or n:find("cart") or n:find("wagon") then
                    if obj.CanCollide then
                        pcall(function() obj.CanCollide = false end)
                    end
                end
            end
        end
    end)
end
--=== 16. БОЙ: инструменты ===
local function getTool(class)
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            if class == nil then
                if t:GetAttribute("Class") ~= "Pickaxe" then return t end
            else
                if t:GetAttribute("Class") == class then return t end
            end
        end
    end
end

local function nearbyNPCs(radius)
    local c = LP.Character
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return {} end
    local out = {}
    for _, n in ipairs(NPCCache) do
        if n.Parent and not blacklisted(n.Name) then
            local h = n:FindFirstChildOfClass("Humanoid")
            local np = n:FindFirstChild("HumanoidRootPart") or n.PrimaryPart
            if h and h.Health > 0 and np
                and (np.Position - r.Position).Magnitude <= radius then
                table.insert(out, n)
            end
        end
    end
    return out
end

