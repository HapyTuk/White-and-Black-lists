--=== 5. ХЕЛПЕРЫ ===
local function parts(model)
    if not model then return nil, nil, nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model.PrimaryPart
    local head = model:FindFirstChild("Head")
    return hum, root, head
end

local function blacklisted(name)
    return table.find(Cfg.BlacklistedNPCs, name) ~= nil
end

local function sameTeam(model)
    if not Cfg.RespectTeams then return false end
    local p = Players:GetPlayerFromCharacter(model)
    if not p or not LP.Team or not p.Team then return false end
    return p.Team == LP.Team
end

--=== 6. КЭШ NPC ===
local NPCCache = {}

local function isValidNPC(m)
    if not m or not m:IsA("Model") then return false end
    if m == LP.Character then return false end
    if Players:GetPlayerFromCharacter(m) then return false end
    if m:GetAttribute("NpcFaction") ~= "Enemy" then return false end
    local h, r = parts(m)
    return h and h.Health > 0 and r ~= nil
end

local function addNPC(m)
    if isValidNPC(m) and not table.find(NPCCache, m) then
        table.insert(NPCCache, m)
        local hum = m:FindFirstChildOfClass("Humanoid")
        if hum then
            track(hum.HealthChanged:Connect(function(v)
                if v <= 0 then
                    local i = table.find(NPCCache, m)
                    if i then table.remove(NPCCache, i) end
                    local g = m:FindFirstChild("3artAimGlow")
                    if g then g:Destroy() end
                end
            end))
        end
    end
end

local function removeNPC(m)
    for i = #NPCCache, 1, -1 do
        if NPCCache[i] == m or (NPCCache[i] and m:IsDescendantOf(NPCCache[i])) then
            table.remove(NPCCache, i)
        end
    end
end

track(Workspace.DescendantAdded:Connect(function(o)
    if o:IsA("Model") then task.defer(function() if o.Parent then addNPC(o) end end) end
end))
track(Workspace.DescendantRemoving:Connect(function(o)
    if o:IsA("Model") then removeNPC(o) end
end))

task.spawn(function()
    for _, o in ipairs(Workspace:GetDescendants()) do
        if o:IsA("Model") then addNPC(o) end
    end
end)

--=== 7. АИМБОТ ===
local function aimPos(model)
    local hum, root, head = parts(model)
    local part
    if Cfg.AimBone == "Head" then part = head or root
    elseif Cfg.AimBone == "UpperTorso" then
        part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or root
    elseif Cfg.AimBone == "HumanoidRootPart" then part = root or head
    else part = head or root end
    if not part or not part:IsA("BasePart") then return nil, nil end

    local vel = part.AssemblyLinearVelocity or Vector3.zero
    local pred = Cfg.VelocityPrediction
    if Cfg.AdvancedPrediction then
        local inAir = hum and hum.FloorMaterial == Enum.Material.Air
        local drop = inAir and Vector3.new(0, 0.5 * Workspace.Gravity * pred * pred, 0)
                            or Vector3.zero
        return part.Position + vel * pred - drop, part
    end
    return part.Position + vel * pred, part
end

local function findTarget()
    local center = Camera.ViewportSize / 2
    local list = {}

    if Cfg.TargetCategory == "Players" or Cfg.TargetCategory == "Both" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not sameTeam(p.Character) then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then table.insert(list, p.Character) end
            end
        end
    end
    if Cfg.TargetCategory == "NPCs" or Cfg.TargetCategory == "Both" then
        for _, n in ipairs(NPCCache) do
            if n.Parent and not blacklisted(n.Name) then table.insert(list, n) end
        end
    end

    local scored = {}
    for _, m in ipairs(list) do
        local pos, part = aimPos(m)
        if pos and part then
            local dist = (Camera.CFrame.Position - part.Position).Magnitude
            if not Cfg.UseRangeLimit or dist <= Cfg.MaxAimDistance then
                local sp, on = Camera:WorldToViewportPoint(pos)
                if on and sp.Z > 0 then
                    local off = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if off <= Cfg.FOVRadius then
                        table.insert(scored, { Model = m, Pos = pos, Offset = off })
                    end
                end
            end
        end
    end
    if #scored == 0 then return nil, nil end
    table.sort(scored, function(a, b) return a.Offset < b.Offset end)
    local best = scored[1]

    if Cfg.WallValidation then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LP.Character, best.Model }
        params.IgnoreWater = true
        local origin = Camera.CFrame.Position
        local hit = Workspace:Raycast(origin, best.Pos - origin, params)
        if hit and hit.Instance and not hit.Instance:IsDescendantOf(best.Model) then
            return nil, nil
        end
    end
    return best.Model, best.Pos
end

local function smoothAim(pos)
    if not pos then return end
    local cur = Camera.CFrame
    Camera.CFrame = cur:Lerp(CFrame.new(cur.Position, pos), Cfg.AimSmoothing)
end
