    while fpsLabel do
        local txt = string.format("FPS: %d | Ping: %dms", fps, ping)
        pcall(function()
            if fpsLabel.Set then fpsLabel:Set(txt)
            elseif fpsLabel.SetText then fpsLabel:SetText(txt)
            else fpsLabel.Text = txt end
        end)
        task.wait(0.2)
    end
end)

