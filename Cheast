--=== 13. FLY (Aerial Control) ===
local Fly = { active = false, up = 0, down = 0, gyro = nil, vel = nil, conns = {} }

local function stopFly()
    for _, c in ipairs(Fly.conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(Fly.conns)
    if Fly.gyro then Fly.gyro:Destroy(); Fly.gyro = nil end
    if Fly.vel then Fly.vel:Destroy(); Fly.vel = nil end
    Fly.up, Fly.down, Fly.active = 0, 0, false
    local c = LP.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false; h.AutoRotate = true end
        local a = c:FindFirstChild("Animate")
        if a then a.Disabled = false end
    end
    if Camera then Camera.CameraType = Enum.CameraType.Custom end
end

local function startFly()
    stopFly()
    local c = LP.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    h.PlatformStand = true
    local a = c:FindFirstChild("Animate")
    if a then a.Disabled = true end
    if Camera then Camera.CameraType = Enum.CameraType.Track end

    Fly.active = true
    Fly.gyro = Instance.new("BodyGyro", r)
    Fly.gyro.P = 90000
    Fly.gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    Fly.gyro.CFrame = r.CFrame

    Fly.vel = Instance.new("BodyVelocity", r)
    Fly.vel.Velocity = Vector3.zero
    Fly.vel.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    table.insert(Fly.conns, RunService.RenderStepped:Connect(function()
        if not Fly.active then return end
        local ch = LP.Character
        local rt = ch and ch:FindFirstChild("HumanoidRootPart")
        if not rt or not Camera then return end

        local mv = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
        mv += Vector3.new(0, 1, 0) * (Fly.up + Fly.down)

        local sp = math.clamp(Cfg.FlightSpeed, 0, 500)
        Fly.vel.Velocity = mv.Magnitude > 0 and mv.Unit * sp or Vector3.zero
        Fly.gyro.CFrame = Camera.CFrame
    end))

    table.insert(Fly.conns, UIS.InputBegan:Connect(function(i, gp)
        if gp or UIS:GetFocusedTextBox() then return end
        if i.KeyCode == Enum.KeyCode.E then Fly.up = 1
        elseif i.KeyCode == Enum.KeyCode.Q then Fly.down = -1 end
    end))

    table.insert(Fly.conns, UIS.InputEnded:Connect(function(i)
        if i.KeyCode == Enum.KeyCode.E then Fly.up = 0
        elseif i.KeyCode == Enum.KeyCode.Q then Fly.down = 0 end
    end))
end

