local EspGui = Instance.new("ScreenGui")
EspGui.Name = "3artAimVisuals"
EspGui.IgnoreGuiInset = true
EspGui.Parent = CoreGui

local FOVFrame = Instance.new("Frame")
FOVFrame.BackgroundTransparency = 1
FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5)
FOVFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
FOVFrame.Parent = EspGui
Instance.new("UICorner", FOVFrame).CornerRadius = UDim.new(1, 0)
local FOVStroke = Instance.new("UIStroke", FOVFrame)

local Tracers, Nametags = {}, {}

local function renderESP()
    local vp = Camera.ViewportSize
    local gs = EspGui.AbsoluteSize
    if gs.X == 0 or gs.Y == 0 then return end
    local sx, sy = vp.X / gs.X, vp.Y / gs.Y

    if FOVStroke then
        local r = Cfg.FOVRadius * sx
        FOVFrame.Size = UDim2.new(0, r * 2, 0, r * 2)
        FOVFrame.Position = UDim2.new(0, gs.X / 2, 0, gs.Y / 2)
        FOVFrame.Visible = Cfg.ShowFOV
        FOVStroke.Thickness = Cfg.FOVStroke
        FOVStroke.Color = Cfg.FOVTint
    end

    local active, list = {}, {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and not sameTeam(p.Character) then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                table.insert(list, { Obj = p.Character, Name = p.Name })
            end
        end
    end
    for _, n in ipairs(NPCCache) do
        if n.Parent and not blacklisted(n.Name) then
            local h = n:FindFirstChildOfClass("Humanoid")
            if not h or h.Health > 0 then
                table.insert(list, { Obj = n, Name = n.Name })
            end
        end
    end

    local top = Vector2.new(gs.X / 2, 0)

    for _, e in ipairs(list) do
        local _, _, head = parts(e.Obj)
        local ref = head or e.Obj.PrimaryPart
        if ref then
            local dist = (Camera.CFrame.Position - ref.Position).Magnitude
            local id = e.Obj:GetDebugId()
            local namePos

            if Cfg.ShowNametags then
                local sp, on = Camera:WorldToViewportPoint(ref.Position + Vector3.new(0, 2.5, 0))
                if on then
                    namePos = Vector2.new(sp.X / sx, sp.Y / sy)
                    local lbl = Nametags[id]
                    if not lbl then
                        lbl = Instance.new("TextLabel")
                        lbl.BackgroundTransparency = 1
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextStrokeTransparency = 0.5
                        lbl.AnchorPoint = Vector2.new(0.5, 0.5)
                        lbl.Parent = EspGui
                        Nametags[id] = lbl
                    end
                    lbl.Text = string.format("%s [%d]", e.Name, math.floor(dist))
                    lbl.TextSize = Cfg.NametagFontSize
                    lbl.TextColor3 = Cfg.NametagColor
                    lbl.Position = UDim2.new(0, namePos.X, 0, namePos.Y)
                    lbl.Visible = true
                    active[id] = true
                end
            end

            if Cfg.ShowTracers then
                local sp, on = Camera:WorldToViewportPoint(ref.Position)
                if on then
                    local endPos = Vector2.new(sp.X / sx, sp.Y / sy)
                    if namePos then
                        endPos = Vector2.new(namePos.X, namePos.Y - Cfg.NametagFontSize / 2 - 4)
                    end
                    local tr = Tracers[id]
                    if not tr then
                        tr = Instance.new("Frame")
                        tr.BorderSizePixel = 0
                        tr.AnchorPoint = Vector2.new(0.5, 0.5)
                        tr.Parent = EspGui
                        Tracers[id] = tr
                    end
                    local mid = (top + endPos) / 2
                    local len = (top - endPos).Magnitude
                    local ang = math.deg(math.atan2(endPos.Y - top.Y, endPos.X - top.X))
                    tr.Position = UDim2.new(0, mid.X, 0, mid.Y)
                    tr.Size = UDim2.new(0, len, 0, Cfg.TracerWidth)
                    tr.Rotation = ang
                    tr.BackgroundColor3 = Cfg.TracerColor
                    tr.Visible = true
                    active[id] = true
                end
            end

            if Cfg.ShowGlow then
                local g = e.Obj:FindFirstChild("3artAimGlow")
                if not g then
                    g = Instance.new("Highlight")
                    g.Name = "3artAimGlow"
                    g.FillTransparency = 1
                    g.Adornee = e.Obj
                    g.Parent = e.Obj
                end
                g.OutlineColor = Cfg.GlowOutline
                g.OutlineTransparency = 0
            end
        end
    end

    for id, t in pairs(Tracers) do
        if not active[id] then t:Destroy(); Tracers[id] = nil end
    end
    for id, l in pairs(Nametags) do
        if not active[id] then l:Destroy(); Nametags[id] = nil end
    end
end

